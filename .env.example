# Copie este arquivo para .env e preencha os valores.
# cp .env.example .env   (ou: Copy-Item .env.example .env no PowerShell)

# Ollama (local) — obrigatório enquanto LLM_PROVIDER=ollama (padrão).
# Instale o Ollama (https://ollama.com) e baixe os três modelos usados por este agente:
#   ollama pull mistral   # geração (OLLAMA_MODEL)
#   ollama pull phi4      # revisão independente (OLLAMA_REVIEW_MODEL)
#   ollama pull bge-m3    # embeddings (OLLAMA_EMBEDDING_MODEL) — memória institucional de refinamento, sem toggle
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_REVIEW_MODEL=phi4
OLLAMA_EMBEDDING_MODEL=bge-m3

# Provedor de LLM ativo p/ geração/revisão: "ollama" (padrão), "nvidia" (NVIDIA NIM,
# build.nvidia.com), "cerebras" (Cerebras Inference, api.cerebras.ai), "google" (Google AI
# Studio, aistudio.google.com) ou "groq" (Groq, console.groq.com). Piloto opcional — não
# altera o comportamento padrão se deixado comentado/ausente. Não afeta embeddings (sempre
# Ollama, sem toggle).
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
# NVIDIA_REVIEW_MODEL=meta/llama-3.3-70b-instruct

# LLM_PROVIDER=cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_REVIEW_MODEL=zai-glm-4.7

# LLM_PROVIDER=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.1-flash-lite
# GOOGLE_REVIEW_MODEL=gemini-2.5-flash-lite

# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_REVIEW_MODEL=openai/gpt-oss-120b
# Groq confirmado com 30 req/min tanto no gerador quanto no revisor — o mais estavel em uso
# real ate agora nesta plataforma (validado ao vivo no Product Owner processando um PRD
# real em lote).

# Jira Cloud — obrigatório apenas para usar --jira (apenas leitura, este agente nunca escreve no Jira)
# Token gerado em id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://seu-site.atlassian.net/
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence Cloud — obrigatório apenas para usar --confluence / --publicar-confluence /
# --atualizar-confluence. Usa as mesmas credenciais do Jira (JIRA_EMAIL / JIRA_API_TOKEN)
# acima. Sem CONFLUENCE_SPACE_KEY: o espaço/página-mãe de publicação é sempre derivado da
# página de origem da UX Specification (get_confluence_publish_location), nunca de
# configuração manual — mesmo padrão do Solution Architect/UX Designer.
